{
  "name": "blockscene",
  "productName": "BlockScene",
  "version": "0.1.0",
  "description": "Escenas 3D y láminas de presentación a partir de construcciones de Minecraft",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "electron-vite build && node scripts/dist.cjs",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "author": "anthonylol12",
  "build": {
    "appId": "app.blockscene.desktop",
    "productName": "BlockScene",
    "copyright": "BlockScene",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "bscene",
        "name": "Proyecto BlockScene",
        "description": "Proyecto de BlockScene",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BlockScene",
      "artifactName": "BlockScene-Setup-${version}.${ext}",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "uninstallDisplayName": "BlockScene"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anthonylol12/BlockScene.git"
  },
  "homepage": "https://github.com/anthonylol12/BlockScene#readme",
  "bugs": {
    "url": "https://github.com/anthonylol12/BlockScene/issues"
  },
  "keywords": [
    "minecraft",
    "schematic",
    "litematic",
    "render",
    "3d",
    "electron",
    "blockscene"
  ]
}
